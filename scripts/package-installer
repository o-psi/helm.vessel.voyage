#!/usr/bin/env bash
# Package only the setup preview, separate from the full product archives.
set -euo pipefail
version="${1:?usage: package-installer UNIQUE_VERSION}"
[[ "$version" =~ ^[A-Za-z0-9._-]+$ && "$version" != . && "$version" != .. ]] || { echo 'invalid version label' >&2; exit 1; }
target="${TARGET:-}"
if [[ -z "$target" ]]; then
  case "$(uname -s)/$(uname -m)" in
    Linux/x86_64) target=x86_64-unknown-linux-gnu ;;
    Darwin/x86_64) target=x86_64-apple-darwin ;;
    Darwin/arm64|Darwin/aarch64) target=aarch64-apple-darwin ;;
    *) echo 'unsupported installer target' >&2; exit 1 ;;
  esac
  binary=target/release/voyage-installer
else
  case "$target" in x86_64-unknown-linux-gnu|x86_64-apple-darwin|aarch64-apple-darwin) ;; *) echo 'unsupported installer target' >&2; exit 1 ;; esac
  binary="target/$target/release/voyage-installer"
fi
[[ -x "$binary" ]] || { echo "missing release binary: $binary" >&2; exit 1; }
output="dist/installer-$version"
mkdir -p dist
mkdir "$output" # A repeated label must never overwrite existing artifacts.
asset="voyage-installer-$target.gz"
gzip -n -c "$binary" > "$output/$asset"
(cd "$output" && if command -v sha256sum >/dev/null 2>&1; then sha256sum "$asset"; else shasum -a 256 "$asset"; fi) > "$output/$asset.sha256"
printf 'created %s/%s\n' "$output" "$asset"
