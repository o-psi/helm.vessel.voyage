[
  {
    "id": "fmt",
    "argv": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ]
  },
  {
    "id": "clippy",
    "argv": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-targets",
      "--all-features",
      "--",
      "-D",
      "warnings"
    ]
  },
  {
    "id": "release-build",
    "argv": [
      "cargo",
      "build",
      "--workspace",
      "--release",
      "--locked"
    ]
  },
  {
    "id": "package-full",
    "argv": [
      "./scripts/package-release",
      "{version}"
    ]
  },
  {
    "id": "checksum-full",
    "argv": [
      "sha256sum",
      "-c"
    ],
    "cwd": "dist",
    "glob_args": "*.sha256"
  },
  {
    "id": "package-installer",
    "argv": [
      "./scripts/package-installer",
      "{version}"
    ]
  },
  {
    "id": "checksum-installer",
    "argv": [
      "sha256sum",
      "-c"
    ],
    "cwd": "dist/installer-{version}",
    "glob_args": "*.sha256"
  }
]
