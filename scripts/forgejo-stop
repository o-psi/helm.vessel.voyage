#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
pid_file="$root/.local-git/forgejo/forgejo.pid"

if [ ! -f "$pid_file" ]; then
  echo "Forgejo is not running"
  exit 0
fi

pid=$(cat "$pid_file")
if kill -0 "$pid" 2>/dev/null; then
  kill "$pid"
  echo "Forgejo stopped (PID $pid)"
else
  echo "Removed stale Forgejo PID file"
fi
rm -f "$pid_file"
