#!/usr/bin/env bash
set -euo pipefail

version="${1:?usage: package-release VERSION}"
target="${TARGET:-}"
target_dir="target${target:+/$target}/release"
archive="voyage-${version}-${target:-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)}"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT

mkdir -p "dist" "$stage/$archive/bin" "$stage/$archive/share/man/man1" \
  "$stage/$archive/share/bash-completion/completions" "$stage/$archive/share/zsh/site-functions" \
  "$stage/$archive/share/fish/vendor_completions.d"
install -m 755 "$target_dir/helm" "$target_dir/vessel" "$stage/$archive/bin/"
for binary in helm vessel; do
  "$target_dir/$binary" manpage > "$stage/$archive/share/man/man1/$binary.1"
  "$target_dir/$binary" completions bash > "$stage/$archive/share/bash-completion/completions/$binary"
  "$target_dir/$binary" completions zsh > "$stage/$archive/share/zsh/site-functions/_$binary"
  "$target_dir/$binary" completions fish > "$stage/$archive/share/fish/vendor_completions.d/$binary.fish"
done
cp README.md LICENSE* "$stage/$archive/" 2>/dev/null || cp README.md "$stage/$archive/"
tar -C "$stage" -czf "dist/$archive.tar.gz" "$archive"
(cd dist && sha256sum "$archive.tar.gz" > "$archive.tar.gz.sha256")
printf 'created dist/%s.tar.gz\n' "$archive"
