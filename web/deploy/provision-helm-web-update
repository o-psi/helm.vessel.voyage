#!/bin/bash
# One-time CT 106 administrator provisioning; never run from a Voyage.
set -Eeuo pipefail
[[ $EUID == 0 && $(uname -m) == x86_64 ]] || { echo 'Root on Linux x86-64 required' >&2; exit 1; }
source_dir=$(cd -- "$(dirname -- "$0")" && pwd)
version=v24.21.0
node_dir=/opt/helm-web/node-$version

if [[ ! -x "$node_dir/bin/node" ]]; then
    work=$(mktemp -d)
    trap 'rm -rf -- "$work"' EXIT
    curl -fsSLo "$work/SHASUMS256.txt" "https://nodejs.org/dist/$version/SHASUMS256.txt"
    curl -fsSLo "$work/node.tar.xz" "https://nodejs.org/dist/$version/node-$version-linux-x64.tar.xz"
    expected=$(awk -v name="node-$version-linux-x64.tar.xz" '$2 == name { print $1 }' "$work/SHASUMS256.txt")
    [[ $expected =~ ^[0-9a-f]{64}$ ]]
    printf '%s  %s\n' "$expected" "$work/node.tar.xz" | sha256sum -c - >/dev/null
    install -d -o root -g root -m 755 "$node_dir"
    tar -xJf "$work/node.tar.xz" -C "$node_dir" --strip-components=1 --no-same-owner
fi
[[ $("$node_dir/bin/node" --version) == "$version" ]]

if ! command -v sudo >/dev/null; then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends sudo
fi
install -o root -g root -m 755 "$source_dir/helm-web-update" /usr/local/sbin/helm-web-update
install -o root -g root -m 644 "$source_dir/helm-web-update.service" /etc/systemd/system/helm-web-update.service
install -o root -g root -m 440 "$source_dir/helm-web-update.sudoers" /etc/sudoers.d/helm-web-update
visudo -cf /etc/sudoers.d/helm-web-update >/dev/null
systemctl daemon-reload
echo 'Scoped Helm Web updater provisioned. Vessel may request only the fixed job.'
